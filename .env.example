# Development / Testing bypass token secret (integration test suites only).
# Generate with: openssl rand -base64 32
# Ignored in production; production requires JWT_SECRET to be set explicitly.
DEV_AUTH_SECRET="deliveryos-dev-secret-change-in-production"

# Email / Invitation Delivery (SMTP)
# When SMTP_HOST is set, invitation emails are delivered over SMTP.
# When it is NOT set, Development/Test delivery falls back to a local "dev
# mailbox" (real .eml files written under backend/dev-mail/); recipients are
# printed with subject + file path only (invite tokens are never logged).
# Production REQUIRES SMTP_HOST: without it, invites fail loudly instead of
# silently pretending an email went out.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"                          # true for 465 (implicit TLS)
# SMTP_USER="apikey"
# SMTP_PASS="<smtp-password-or-api-key>"
# MAIL_FROM="DeliveryOS <no-reply@your-domain.com>"
# DEV_MAIL_DIR="<absolute-path-to-dev-mailbox>" # overrides backend/dev-mail

# Frontend Configuration (Vite - Publicly Exposed via VITE_ prefix)
# VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# VITE_API_BASE_URL="http://localhost:4000/api"

